{
  "version": "0.2.0",
  "configurations": [
    
    
    {
      "type": "gdbtarget",
      "request": "attach",
      "name": "Eclipse CDT GDB Adapter"
      
    },
    {
      "type": "espidf",
      "name": "Launch",
      "request": "launch",
      "setupCommands": [
        {
          "description": "Ignore SIGINT - prevent GDB from stopping on UART TX FIFO polling",
          "text": "handle SIGINT nostop noprint pass",
          "ignoreFailures": false
        }
      ]
    }
  ]
}