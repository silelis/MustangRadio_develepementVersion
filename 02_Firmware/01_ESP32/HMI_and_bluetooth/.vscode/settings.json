  "esp_python_path_ver": "v5.2",
  "tools_esp32ulp-elf_ver": "2.35_20220830",
  "tools_openocd-esp32_ver": "v0.12.0-esp32-20230921",
  "tools_xtensa-esp-elf_ver": "esp-13.2.0_20230928",
  "tools_esp_idf-python_ver": "3.13.12",
  "tools_esp-clang_ver": "16.0.1-fe4f10a809",
  "tools_xtensa-esp-elf-gdb_ver": "12.1_20231023",
  "tools_ADDR2LINE_ver": "esp-13.2.0_20230928",
  "framework_esp-idf_ver": "esp-idf-v5.2.0",
  "esp_idf_tools": "${config:esp_idf_path}/tools",
  "esp_toolchain_root": "${env:HOME}/.espressif",
  "esp_binutils_path": "${config:esp_idf_tools}/esp32ulp-elf/${config:tools_esp32ulp-elf_ver}/esp32ulp-elf/bin",
  "esp_openocd_path": "${config:esp_idf_tools}/openocd-esp32/${config:tools_openocd-esp32_ver}/openocd-esp32/bin",
  "esp_python_path": "${config:esp_idf_tools}/python/${config:esp_python_path_ver}/venv/Scripts",
  "esp_toolchain_path": "${config:esp_idf_tools}/xtensa-esp-elf/${config:tools_xtensa-esp-elf_ver}/xtensa-esp-elf/bin",
  "esp_ADDR2LINE_path": "${config:esp_idf_tools}/xtensa-esp-elf/${config:tools_ADDR2LINE_ver}/xtensa-esp-elf/bin",
  "esp_clang_path": "${config:esp_idf_tools}/esp-clang/${config:tools_esp-clang_ver}/esp-clang/bin",
  "esp_gdb_path": "${config:esp_idf_tools}/xtensa-esp-elf-gdb/${config:tools_xtensa-esp-elf-gdb_ver}/xtensa-esp-elf-gdb/bin",
  "esp_dev_env_path": "${config:esp_idf_tools}:${config:esp_binutils_path}:${config:esp_openocd_path}:${config:esp_python_path}:${config:esp_toolchain_path}:${config:esp_clang_path}:${config:esp_gdb_path}",
  "idf.espIdfPathWin": "C:/esp/v5.2/esp-idf",
  "idf.pythonInstallPath": "${config:esp_idf_tools}/python/${config:esp_python_path_ver}/venv/Scripts/python.exe",
  "idf.openOcdDebugLevel": 0,
  "idf.openOcdLaunchArgs": [
    "-f",
    "interface/ftdi/esp_ftdi.cfg",
    "-f",
    "target/esp32.cfg",
    "-c",
    //"adapter speed 400",  // stare - za wolne, JTAG reaguje zbyt ospale na halty
    "adapter speed 4000",   // zwiększono: szybszy JTAG = szybsze zatrzymanie CPU przed kolejnym IRQ
    "-c",
    "init",
    "-c",
    "reset halt",
    //"-c",
    //"esp32.cpu0 configure -rtos FreeRTOS",
    //"-c",
    //"esp32.cpu1 configure -rtos FreeRTOS",
     "-c",
     "set ESP_RTOS none"  // usunięto: sprzeczne z configure -rtos FreeRTOS powyżej
    //"-c",
    //"esp32 smpbreak BreakIn BreakOut"  // dodano: atomowe zatrzymanie obu rdzeni - cpu1 (BT) nie generuje IRQ do cpu0 po halcie
   ],
  "idf.portWin": "COM5",
  "idf.toolsPathWin": "${config:esp_idf_path}",
  "idf.customExtraVars": {
    "ESPTOOLPY_ARGS": "--no-verify",
    "IDF_TARGET": "esp32"
  },
  "clangd.path": "C:\\Espressif\\tools\\esp-clang\\16.0.1-fe4f10a809\\esp-clang\\bin\\clangd.exe",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=C:\\Espressif\\tools\\xtensa-esp-elf\\esp-13.2.0_20230928\\xtensa-esp-elf\\bin\\xtensa-esp32-elf-gcc.exe",
    "--compile-commands-dir=d:\\!!!__GitHUB_repositories\\MustangRadio_develepementVersion\\02_Firmware\\01_ESP32\\HMI_and_bluetooth\\build"
  ],
  "idf.flashType": "JTAG",
  "idf.currentSetup": "C:\\esp\\v5.2\\esp-idf"
}
