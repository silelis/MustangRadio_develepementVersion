{
  // ============================================================
  // KONFIGURACJA WERSJI
  // Przy aktualizacji ESP-IDF zmień TYLKO tę sekcję.
  // ============================================================

  // Ścieżka główna ESP-IDF (idf.py, components/, tools/cmake/)
  "esp_idf_root": "C:/esp/v5.5.3/esp-idf",

  // Katalog narzędzi Espressif (tools/, python_env/)
  "esp_tools_root": "C:/Espressif",

  // Wersje narzędzi — podkatalogi w esp_tools_root/tools/<TOOL>/<WERSJA>/
  "esp_ver_xtensa":     "esp-14.2.0_20251107",
  "esp_ver_openocd":    "v0.12.0-esp32-20250707",
  "esp_ver_clang":      "esp-19.1.2_20250312",
  "esp_ver_gdb":        "16.3_20250913",
  "esp_ver_python_env": "idf5.5_py3.11_env",

  // ============================================================
  // ŚCIEŻKI POCHODNE — nie zmieniaj (wyliczane z sekcji powyżej)
  // Używane przez rozszerzenie ESP-IDF oraz c_cpp_properties.json.
  // ============================================================

  "esp_compiler_bin": "${config:esp_tools_root}/tools/xtensa-esp-elf/${config:esp_ver_xtensa}/xtensa-esp-elf/bin",
  "esp_openocd_bin":  "${config:esp_tools_root}/tools/openocd-esp32/${config:esp_ver_openocd}/openocd-esp32/bin",
  "esp_clang_bin":    "${config:esp_tools_root}/tools/esp-clang/${config:esp_ver_clang}/esp-clang/bin",
  "esp_gdb_bin":      "${config:esp_tools_root}/tools/xtensa-esp-elf-gdb/${config:esp_ver_gdb}/xtensa-esp-elf-gdb/bin",
  "esp_python_bin":   "${config:esp_tools_root}/python_env/${config:esp_ver_python_env}/Scripts",

  // ============================================================
  // USTAWIENIA ROZSZERZENIA ESP-IDF
  // ============================================================

  "idf.espIdfPathWin":     "${config:esp_idf_root}",
  "idf.toolsPathWin":      "${config:esp_tools_root}",
  "idf.currentSetup":      "${config:esp_idf_root}",
  "idf.flashType":         "JTAG",
  "idf.portWin":           "COM7",
  "idf.openOcdDebugLevel": 0,

  "idf.openOcdLaunchArgs": [
    "-f", "interface/ftdi/esp_ftdi.cfg",
    "-f", "target/esp32.cfg",
    "-c", "adapter speed 400",
    "-c", "init",
    "-c", "reset halt",
    "-c", "esp32.cpu0 configure -rtos FreeRTOS",
    "-c", "esp32.cpu1 configure -rtos FreeRTOS",
    "-c", "set ESP_RTOS none"
  ],

  "idf.customExtraVars": {
    "IDF_TARGET": "esp32"
  },

  // ============================================================
  // INTELLISENSE — rozszerzenie C/C++ Microsoft
  // ============================================================

  "C_Cpp.intelliSenseEngine": "default",

  // ============================================================
  // CLANGD
  // UWAGA: clangd nie obsługuje ${config:...} — ścieżki absolutne.
  // Przy zmianie wersji zaktualizuj esp_ver_xtensa / esp_ver_clang
  // ORAZ poniższe dwa klucze ręcznie (ten sam ciąg wersji).
  // ============================================================

  "clangd.path": "C:/Espressif/tools/esp-clang/esp-19.1.2_20250312/esp-clang/bin/clangd.exe",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=C:/Espressif/tools/xtensa-esp-elf/esp-14.2.0_20251107/xtensa-esp-elf/bin/xtensa-esp32-elf-gcc.exe",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],

  // ============================================================
  // TERMINAL — profil ESP-IDF (aktywuje środowisko IDF)
  // ============================================================

  "terminal.integrated.profiles.windows": {
    "ESP-IDF": {
      "path": "cmd.exe",
      "args": ["/k", "${config:esp_idf_root}/export.bat"],
      "icon": "terminal",
      "overrideName": true
    }
  },
  "terminal.integrated.defaultProfile.windows": "ESP-IDF",

  // ============================================================
  // SKOJARZENIA PLIKÓW
  // ============================================================

  "files.associations": {
    "chrono": "cpp",
    "text_encoding": "cpp",
    "typeinfo": "cpp",
    "iostream": "cpp"
  }
}
