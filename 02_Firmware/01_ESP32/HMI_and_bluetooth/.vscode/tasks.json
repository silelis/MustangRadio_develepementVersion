{
  "version": "2.0.0",
  "tasks": [

    // ============================================================
    // BUILD
    // ============================================================
    {
      "label": "Build",
      "type": "shell",
      "command": "${command:espIdf.buildDevice}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$gcc"
    },

    // ============================================================
    // FLASH (JTAG)
    // ============================================================
    {
      "label": "Flash (JTAG)",
      "type": "shell",
      "command": "${command:espIdf.flashDevice}",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ============================================================
    // BUILD + FLASH — kompiluje, a następnie wgrywa firmware
    // Używane też jako preLaunchTask przez konfiguracje debugowania.
    // ============================================================
    {
      "label": "Build + Flash",
      "dependsOrder": "sequence",
      "dependsOn": ["Build", "Flash (JTAG)"],
      "group": "build",
      "problemMatcher": []
    },

    // ============================================================
    // CLEAN
    // ============================================================
    {
      "label": "Clean (Full)",
      "type": "shell",
      "command": "${command:espIdf.fullClean}",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ============================================================
    // MENUCONFIG
    // ============================================================
    {
      "label": "Menuconfig",
      "type": "shell",
      "command": "${command:espIdf.menuconfig.start}",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": []
    },

    // ============================================================
    // DECODE GURU MEDITATION ERROR
    // Dekoduje adresy z crash dump na symbole — wymaga pliku .elf.
    // ============================================================
    {
      "label": "Decode Guru Meditation Error",
      "type": "process",
      "command": "${config:esp_python_bin}/python.exe",
      "args": [
        "${workspaceFolder}/.vscode/scripts/decode_guru.py",
        "${input:elfFilePath}"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "options": {
        "env": {
          "ADDR2LINE_PATH": "${config:esp_compiler_bin}/xtensa-esp32-elf-addr2line.exe"
        }
      },
      "problemMatcher": []
    }

  ],

  // ============================================================
  // INPUTS
  // ============================================================
  "inputs": [
    {
      "id": "elfFilePath",
      "type": "promptString",
      "description": "Ścieżka do pliku .elf (względna od workspaceFolder):",
      "default": "build/HMI_and_bluetooth.elf"
    }
  ]
}
